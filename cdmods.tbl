    dump = "# Effective cooldown modifiers (ArcheAge Classic, patch 293). Tab-separated, one row per source.\n# Columns:\n#   id            buff/debuff id (0 = detect by name only)\n#   name          buff name exactly as the client reports it\n#   scope         skillset tree the modifier applies to (empty or \"all\" = every tree)\n#   skill         skill-name filter (empty = all skills of the scope)\n#   pct           flat percentage removed from the cooldown (applied once)\n#   flat          flat seconds removed from the cooldown (applied once)\n#   pctPerStack   percentage per stack\n#   flatPerStack  seconds per stack\n#   maxStacks     stack clamp for the per-stack columns\n#   effect        dynamic | reset | passive | snap\n#   icdMs         internal cooldown for reset effects, milliseconds\n#\n# dynamic = applied only while the aura is visible on the target (reverts when it fades)\n# reset   = proc that makes the tree's cooldowns ready (handled separately from the ratio)\n# passive = known skillset passive; only a snapping candidate, never applied by default\n# snap    = extra candidate ratio for learning (pct is the total reduction it stands for)\n7651\tBattle Focus\tBattlerage\t\t35\t0\t0\t0\t0\tdynamic\t0\n13612\tBattle Focus\tBattlerage\t\t40\t0\t0\t0\t0\tdynamic\t0\n9000610\tCooldown Reduction\tall\t\t10\t0\t0\t0\t0\tdynamic\t0\n2611\tDeflect and Retaliate\tBattlerage\t\t0\t0\t0\t0\t0\treset\t12000\n0\tQuick Recovery\tVitalism\t\t0\t0\t0\t0\t0\treset\t12000\n0\tRhythm\tSongcraft\t\t0\t0\t0\t0.4\t15\tdynamic\t0\n0\tMana Fountain\tSorcery\t\t0\t0\t2\t0\t8\tdynamic\t0\n0\tInspired\t\tAntithesis\t0\t0.6\t0\t0\t0\tdynamic\t0\n0\tInspired\t\tMend\t0\t2.1\t0\t0\t0\tdynamic\t0\n0\tInspired\t\tFervent Healing\t0\t1.2\t0\t0\t0\tdynamic\t0\n0\tExploitation\tWitchcraft\tFocal Concussion\t0\t0\t10\t0\t5\tdynamic\t0\n0\tExploitation\tWitchcraft\tEnervate\t0\t0\t10\t0\t5\tdynamic\t0\n0\tAttack Speed Training\tBattlerage\t\t10\t0\t0\t0\t0\tpassive\t0\n0\tEnshroud\tWitchc